---
interface Props { name: string; size?: number; stroke?: string; width?: number }
const { name, size = 20, stroke = 'currentColor', width = 1.6 } = Astro.props;
---
<svg width={size} height={size} viewBox="0 0 24 24" fill="none" aria-hidden="true" stroke={stroke} stroke-width={width} stroke-linecap="round" stroke-linejoin="round">
  {name === 'all' && (<><rect x="4" y="4" width="7" height="7" rx="1.5" /><rect x="13" y="4" width="7" height="7" rx="1.5" /><rect x="4" y="13" width="7" height="7" rx="1.5" /><rect x="13" y="13" width="7" height="7" rx="1.5" /></>)}
  {name === 'ict' && (<><rect x="4" y="5" width="16" height="10" rx="1.5" /><path d="M8 19h8M12 15v4M8 10h4" /></>)}
  {name === 'bim' && (<><path d="M12 3l8 4.5v9L12 21l-8-4.5v-9z" /><path d="M4 7.5l8 4.5 8-4.5M12 12v9" /></>)}
  {name === 'ir' && (<><rect x="5" y="3" width="14" height="18" rx="2" /><path d="M9 8h6M9 12h6M9 16l1.5 1.5L14 14" /></>)}
  {name === 'camera' && (<><rect x="3" y="7" width="18" height="13" rx="2" /><circle cx="12" cy="13.5" r="3.5" /><path d="M9 7l1.5-3h3L15 7" /></>)}
  {name === 'note' && (<><path d="M5 4h10l4 4v12H5z" /><path d="M14 4v5h5M8 13h8M8 17h5" /></>)}
  {name === 'user' && (<><circle cx="12" cy="8" r="4" /><path d="M4 20c1.5-4 4.5-6 8-6s6.5 2 8 6" /></>)}
  {name === 'mail' && (<><path d="M4 5h16v11H9l-5 4z" /></>)}
  {name === 'github' && (<path d="M9 19c-4 1.5-4-2-6-2.5M15 21v-3.5c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6a4.6 4.6 0 0 0-1.3-3.2 4.2 4.2 0 0 0-.1-3.2s-1.1-.3-3.5 1.3a12 12 0 0 0-6.2 0C6.5 2.8 5.4 3.1 5.4 3.1a4.2 4.2 0 0 0-.1 3.2A4.6 4.6 0 0 0 4 9.5c0 4.6 2.7 5.7 5.5 6-.6.6-.6 1.2-.5 2V21" />)}
  {name === 'edit' && (<><path d="M4 20h4L19 9l-4-4L4 16z" /><path d="M13 7l4 4" /></>)}
  {name === 'search' && (<><circle cx="11" cy="11" r="6.5" /><path d="M16 16l4 4" /></>)}
  {name === 'target' && (<><circle cx="12" cy="12" r="7" /><circle cx="12" cy="12" r="2.5" /><path d="M12 2v3M12 19v3M2 12h3M19 12h3" /></>)}
  {name === 'clock' && (<><circle cx="12" cy="13" r="7.5" /><path d="M12 9v4l2.5 2M5 4L3 6M19 4l2 2" /></>)}
  {name === 'arrow-right' && (<path d="M5 12h14M13 6l6 6-6 6" />)}
  {name === 'arrow-left' && (<path d="M19 12H5M11 6l-6 6 6 6" />)}
  {name === 'menu' && (<path d="M4 7h16M4 12h16M4 17h16" />)}
</svg>
