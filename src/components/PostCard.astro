---
import Icon from './Icon.astro';
import { categoryOf, fmtDate, type Post } from '../lib';
interface Props { post: Post }
const { post } = Astro.props;
const cat = categoryOf(post.data.category);
const href = `/posts/${post.id}/`;
---
<article class="card" data-title={post.data.title.toLowerCase()} data-tags={post.data.tags.join(' ').toLowerCase()}>
  <span class="card-icon" style={`background:${cat.color};box-shadow:0 10px 20px ${cat.color}55`}><Icon name={cat.icon} size={24} stroke="#FFFFFF" width={1.8} /></span>
  <h2 class="card-title"><a href={href}>{post.data.title}</a></h2>
  <div class="card-meta">
    <span><Icon name="target" size={16} width={1.4} />{cat.name}</span>
    <span><Icon name="clock" size={16} width={1.4} /><time datetime={post.data.date.toISOString()}>{fmtDate(post.data.date)}</time></span>
  </div>
  <div class="card-rule"></div>
  <div class="card-foot">
    <div class="card-tags">
      <span class="card-label">태그</span>
      <div class="chips">{post.data.tags.length ? post.data.tags.map((t) => <span class="chip">{t}</span>) : <span class="chip">—</span>}</div>
    </div>
    <a href={href} class="card-go" aria-label={`${post.data.title} 읽기`}><Icon name="arrow-right" size={14} /></a>
  </div>
</article>
